<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- VIRE — Midnight Circuit Theme -->
    <style name="Theme.VIRE" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Window background and System bars -->
        <item name="android:windowBackground">@color/circuit_bg</item>
        <item name="android:colorBackground">@color/circuit_bg</item>
        <item name="android:statusBarColor">@color/circuit_bg</item>
        <item name="android:navigationBarColor">@color/circuit_bottom_nav</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Primary brand color (Electric Neon Lime) -->
        <item name="colorPrimary">@color/circuit_lime</item>
        <item name="colorPrimaryVariant">@color/circuit_lime_dark</item>
        <item name="colorOnPrimary">@color/circuit_black</item>

        <!-- Secondary brand color (Cyan / Mint) -->
        <item name="colorSecondary">@color/circuit_secondary</item>
        <item name="colorSecondaryVariant">@color/circuit_secondary_dark</item>
        <item name="colorOnSecondary">@color/circuit_black</item>

        <!-- Surface and On-Surface -->
        <item name="colorSurface">@color/circuit_card</item>
        <item name="colorOnSurface">@color/circuit_text_primary</item>
        <item name="colorOnBackground">@color/circuit_text_primary</item>

        <!-- Typography / Text colors -->
        <item name="android:textColor">@color/circuit_text_primary</item>
        <item name="android:textColorPrimary">@color/circuit_text_primary</item>
        <item name="android:textColorSecondary">@color/circuit_text_secondary</item>
        <item name="android:textColorHint">@color/circuit_text_muted</item>

        <!-- Global CardView Style: dark slate card with subtle elevation and rounded corners -->
        <item name="cardViewStyle">@style/Widget.VIRE.CardView</item>

        <!-- Material Buttons -->
        <item name="materialButtonStyle">@style/Widget.VIRE.Button</item>
        <item name="buttonStyle">@style/Widget.VIRE.Button</item>

        <!-- Floating Action Button -->
        <item name="floatingActionButtonStyle">@style/Widget.VIRE.FloatingActionButton</item>

        <!-- Dialogs -->
        <item name="alertDialogTheme">@style/Theme.VIRE.Dialog</item>
        <item name="android:dialogTheme">@style/Theme.VIRE.Dialog</item>
    </style>

    <!-- Global CardView widget default -->
    <style name="Widget.VIRE.CardView" parent="CardView">
        <item name="cardBackgroundColor">@color/circuit_card</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Global Primary Button: Electric Neon Lime with Bold Black Text -->
    <style name="Widget.VIRE.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/circuit_lime</item>
        <item name="android:textColor">@color/circuit_black</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="rippleColor">@color/circuit_lime_light</item>
    </style>

    <!-- Secondary Outlined Button -->
    <style name="Widget.VIRE.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/circuit_text_primary</item>
        <item name="strokeColor">@color/circuit_surface_border</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Floating Action Button: Neon Lime with Black Icon -->
    <style name="Widget.VIRE.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/circuit_lime</item>
        <item name="tint">@color/circuit_black</item>
        <item name="rippleColor">@color/circuit_lime_light</item>
    </style>

    <!-- Alert Dialog Theme: Dark Surface with High-Contrast Text -->
    <style name="Theme.VIRE.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowBackground">@drawable/circuit_dialog_bg</item>
        <item name="colorSurface">@color/circuit_card</item>
        <item name="colorOnSurface">@color/circuit_text_primary</item>
        <item name="android:textColorPrimary">@color/circuit_text_primary</item>
        <item name="android:textColor">@color/circuit_text_primary</item>
        <item name="colorPrimary">@color/circuit_lime</item>
        <item name="colorOnPrimary">@color/circuit_black</item>
    </style>
</resources>
