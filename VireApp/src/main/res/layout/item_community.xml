<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    android:foreground="?android:attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/communityName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btnJoinCommunity"
            android:text="Community Name"
            android:textColor="#212121"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnJoinCommunity"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/communityName"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Join"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/communityCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/communityName"
            android:layout_marginTop="4dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="#E3F2FD"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="TCG"
            android:textColor="#1565C0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/communityDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/communityCategory"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Community description..."
            android:textColor="#616161"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/communityMemberCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/communityDescription"
            android:layout_marginTop="8dp"
            android:text="👥 0 Members"
            android:textColor="#1565C0"
            android:textSize="12sp"
            android:textStyle="bold" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
