<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/deck_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/circuit_bg"
    android:fitsSystemWindows="true"
    tools:context=".DeckListActivity">

    <LinearLayout
        android:id="@+id/deckHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="VIRE / DECKS &amp; COLLECTION"
                android:textColor="@color/circuit_text_muted"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/deckListTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Your arsenal"
                android:textColor="@color/circuit_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/btnDeckNotifications"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_bell"
            app:tint="@color/circuit_text_primary" />
        <ImageView
            android:id="@+id/btnDeckProfile"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/profile_image_bg"
            android:contentDescription="My Profile"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_placeholder" />
    </LinearLayout>

    <EditText
        android:id="@+id/searchDecks"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/deckHeaderRow"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/search_bar_bg"
        android:hint="Search decks or cards"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="@color/circuit_text_primary"
        android:textColorHint="@color/circuit_text_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/deckMetrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchDecks"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/search_bar_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">
            <TextView
                android:id="@+id/tvDeckMetricCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/circuit_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Decks"
                android:textColor="@color/circuit_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_marginHorizontal="3dp"
            android:layout_weight="1"
            android:background="@drawable/search_bar_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">
            <TextView
                android:id="@+id/tvCardsOwned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/circuit_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cards owned"
                android:textColor="@color/circuit_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="74dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/search_bar_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">
            <TextView
                android:id="@+id/deckCountText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 decks"
                android:textColor="@color/circuit_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current view"
                android:textColor="@color/circuit_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <RadioGroup
        android:id="@+id/rgDeckScope"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/deckMetrics"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/pill_tab_inactive"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="4dp">
        <RadioButton
            android:id="@+id/rbMyDecks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/pill_tab_active"
            android:button="@null"
            android:checked="true"
            android:gravity="center"
            android:text="My decks"
            android:textColor="@color/circuit_lime"
            android:textSize="13sp" />
        <RadioButton
            android:id="@+id/rbPublicDecks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:button="@null"
            android:gravity="center"
            android:text="Community"
            android:textColor="@color/circuit_text_secondary"
            android:textSize="13sp" />
    </RadioGroup>

    <Spinner
        android:id="@+id/spinnerDeckGameFilter"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_below="@id/rgDeckScope"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/search_bar_bg"
        android:paddingHorizontal="10dp" />

    <LinearLayout
        android:id="@+id/decksSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/spinnerDeckGameFilter"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Your decks"
            android:textColor="@color/circuit_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyDecksText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:padding="16dp"
        android:text="No decks found.\nBuild your first TCG deck."
        android:textAlignment="center"
        android:textColor="@color/circuit_text_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDecks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/decksSectionHeader"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="96dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateDeck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNav"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Create Deck"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/circuit_lime"
        app:tint="@color/circuit_black" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
