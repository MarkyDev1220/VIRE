<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/circuit_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/homeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="VIRE / YOUR DAILY CIRCUIT"
                android:textColor="@color/circuit_text_muted"
                android:textSize="10sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="The feed"
                android:textColor="@color/circuit_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnHomeNotifications"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_bell"
            app:tint="@color/circuit_text_primary" />
        <ImageView
            android:id="@+id/userAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/profile_image_bg"
            android:contentDescription="My Profile"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_placeholder" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/homeFeedTabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/homeHeader"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/tabHomeForYou"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/pill_tab_active"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="For you"
            android:textColor="@color/circuit_lime"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tabHomeFollowing"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/pill_tab_inactive"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Following"
            android:textColor="@color/circuit_text_secondary"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tabHomeLocal"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/pill_tab_inactive"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Local"
            android:textColor="@color/circuit_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/postComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/homeFeedTabs"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/search_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/composerAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/profile_image_bg"
            android:contentDescription="User Avatar"
            android:src="@drawable/ic_profile_placeholder" />
        <TextView
            android:id="@+id/createPostPrompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:text="What's your next play?"
            android:textColor="@color/circuit_text_secondary"
            android:textSize="14sp" />
        <Button
            android:id="@+id/btnHomeCreatePost"
            style="@style/Widget.VIRE.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="68dp"
            android:text="Post"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardHomeGameNight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/postComposer"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/circuit_lime_muted"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Game night"
                android:src="@drawable/ic_tournaments"
                app:tint="@color/circuit_lime" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvHomeGameNightTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Find your next game night"
                    android:textColor="@color/circuit_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvHomeGameNightSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Browse open tables near you"
                    android:textColor="@color/circuit_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↗"
                android:textColor="@color/circuit_lime"
                android:textSize="20sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ListView
        android:id="@+id/feedListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/cardHomeGameNight"
        android:clipToPadding="false"
        android:divider="@color/circuit_bg"
        android:dividerHeight="12dp"
        android:paddingHorizontal="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
