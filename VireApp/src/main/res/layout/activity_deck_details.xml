<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".DeckDetailsActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Title -->
        <TextView
            android:id="@+id/detailsDeckTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deck Title"
            android:textColor="#212121"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Badges Row -->
        <LinearLayout
            android:id="@+id/detailsDeckBadgesRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsDeckTitle"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detailsDeckGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_background"
                android:backgroundTint="#E3F2FD"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Magic: The Gathering"
                android:textColor="#1565C0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailsDeckFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#FFF3E0"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Commander"
                android:textColor="#E65100"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailsDeckCardCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="🃏 0 Cards"
                android:textColor="#424242"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Description / Strategy -->
        <TextView
            android:id="@+id/detailsDeckDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsDeckBadgesRow"
            android:layout_marginTop="8dp"
            android:text="Deck description &amp; strategy..."
            android:textColor="#616161"
            android:textSize="13sp" />

        <!-- Discord Button -->
        <Button
            android:id="@+id/btnOpenDeckDiscord"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsDeckDesc"
            android:layout_marginTop="8dp"
            android:text="💬 Discord / Match Room"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Cards Section Header -->
        <RelativeLayout
            android:id="@+id/cardsHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/btnOpenDeckDiscord"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Cards in Deck"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAddCardToDeck"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="+ Add Card"
                android:textColor="#1565C0" />

        </RelativeLayout>

        <!-- Cards RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDeckCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardsHeaderRow"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false" />

        <!-- Chat Companion Section Header -->
        <TextView
            android:id="@+id/chatCompanionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/recyclerDeckCards"
            android:layout_marginTop="20dp"
            android:text="💬 Deck Chat Companion &amp; Discussion"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Chat Input Row -->
        <LinearLayout
            android:id="@+id/chatInputRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/chatCompanionHeader"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/editDeckCommentInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/search_bar_bg"
                android:hint="Ask for deck feedback or strategy tips..."
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnSendDeckComment"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_bg"
                android:contentDescription="Send message"
                android:src="@drawable/ic_send"
                app:tint="@android:color/white" />

        </LinearLayout>

        <!-- Chat Comments List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDeckComments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/chatInputRow"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <!-- Hamburger Menu Button -->
        <ImageButton
            android:id="@+id/hamburgerButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_below="@id/recyclerDeckComments"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20dp"
            android:background="@drawable/circle_bg"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu_hamburger"
            app:tint="@android:color/white" />

    </RelativeLayout>

</ScrollView>
