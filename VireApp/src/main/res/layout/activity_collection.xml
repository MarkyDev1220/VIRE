<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/collection_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/circuit_bg"
    android:fitsSystemWindows="true"
    android:padding="12dp"
    tools:context=".CollectionActivity">

    <!-- Header row: Title + Item Count -->
    <LinearLayout
        android:id="@+id/collectionHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/collectionTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Collection"
            android:textColor="@color/circuit_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/collectionCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 items"
            android:textColor="@color/circuit_text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Search View -->
    <SearchView
        android:id="@+id/searchViewCollection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/collectionHeaderRow"
        android:layout_marginTop="4dp"
        android:iconifiedByDefault="false"
        android:queryHint="Search collection..." />

    <!-- Filter row (Type & Status) -->
    <LinearLayout
        android:id="@+id/rowCollectionFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchViewCollection"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Type Filter -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type:"
            android:textColor="@color/circuit_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerFilterType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp" />

        <!-- Status Filter -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Status:"
            android:textColor="@color/circuit_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerFilterStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Empty text -->
    <TextView
        android:id="@+id/emptyCollectionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:padding="16dp"
        android:text="Your collection is empty.\nTap + to add games, decks, or expansions!"
        android:textAlignment="center"
        android:textColor="@color/circuit_text_muted"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Collection RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCollection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/rowCollectionFilters"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <!-- Add Item FAB (+) moved UP above bottom navigation menu -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddCollectionItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNav"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Add collection item"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/circuit_lime"
        app:tint="@color/circuit_black" />

    <!-- Bottom Navigation Bar -->
    <include
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
