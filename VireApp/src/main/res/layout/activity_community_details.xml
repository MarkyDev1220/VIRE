<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".CommunityDetailsActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Title & Join Row -->
        <RelativeLayout
            android:id="@+id/communityHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/detailsCommunityName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/btnJoinLeaveCommunity"
                android:text="Community Name"
                android:textColor="#212121"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnJoinLeaveCommunity"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_alignParentEnd="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Join Community"
                android:textSize="12sp" />

        </RelativeLayout>

        <LinearLayout
            android:id="@+id/communitySubHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/communityHeader"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detailsCommunityCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_background"
                android:backgroundTint="#E3F2FD"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="TCG"
                android:textColor="#1565C0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailsCommunityMembers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="👥 0 Members"
                android:textColor="#616161"
                android:textSize="13sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/detailsCommunityDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/communitySubHeader"
            android:layout_marginTop="8dp"
            android:text="Community description..."
            android:textColor="#424242"
            android:textSize="14sp" />

        <!-- Feed Section Header -->
        <RelativeLayout
            android:id="@+id/feedHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsCommunityDesc"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Community Discussions"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCreatePost"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="+ New Post"
                android:textColor="#1565C0" />

        </RelativeLayout>

        <TextView
            android:id="@+id/emptyCommunityPostsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/feedHeaderRow"
            android:layout_marginTop="4dp"
            android:text="No posts in this community yet. Tap + New Post to start the conversation!"
            android:textColor="#757575"
            android:textSize="13sp" />

        <!-- Posts List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCommunityPosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/emptyCommunityPostsText"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <!-- Hamburger Menu Button -->
        <ImageButton
            android:id="@+id/hamburgerButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_below="@id/recyclerCommunityPosts"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20dp"
            android:background="@drawable/circle_bg"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu_hamburger"
            app:tint="@android:color/white" />

    </RelativeLayout>

</ScrollView>
