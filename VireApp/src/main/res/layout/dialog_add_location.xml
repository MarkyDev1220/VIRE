<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Store / Venue Name *"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editLocationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Dragon's Lair Games"
            android:inputType="textCapWords" />

        <!-- Type -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Venue Type"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerLocationType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Address -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Street Address"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editLocationAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="123 Gaming Way"
            android:inputType="textPostalAddress" />

        <!-- City & State Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="City"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editLocationCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Austin"
                    android:inputType="textCapWords" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="State"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editLocationState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="TX"
                    android:inputType="textCapCharacters" />
            </LinearLayout>

        </LinearLayout>

        <!-- Phone & Website -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Phone Number"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editLocationPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="(512) 555-0199"
            android:inputType="phone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Website / Social Link"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editLocationWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://dragonslair.com"
            android:inputType="textUri" />

        <!-- Supported Games -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Supported Games (comma-separated)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editLocationSupportedGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. MTG, Pokémon, D&amp;D, Warhammer, Board Games" />

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Store Description"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editLocationDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tell players about table space, weekly events, food, parking..."
            android:inputType="textMultiLine"
            android:lines="3" />

        <!-- Photo Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Store Cover Photo"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/locationImagePreview"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder"
                android:contentDescription="Photo Preview" />

            <Button
                android:id="@+id/btnPickLocationPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Choose Photo" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
