<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/rankingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rankings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"/>

    <!-- Spinner for TCG games -->
    <Spinner
        android:id="@+id/gameSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rankingsTitle"
        android:layout_marginBottom="16dp"/>

    <!-- Leaderboard List -->
    <ListView
        android:id="@+id/leaderboardList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/gameSpinner"
        android:layout_above="@id/hamburgerButton"
        android:dividerHeight="1dp"
        android:paddingBottom="8dp"/>

    <!-- Floating Hamburger Menu -->
    <ImageButton
        android:id="@+id/hamburgerButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:background="@drawable/circle_bg"
        android:src="@drawable/ic_menu_hamburger"
        android:contentDescription="Menu"
        android:tint="@android:color/white"
        android:clickable="true"
        android:focusable="true" />

</RelativeLayout>
