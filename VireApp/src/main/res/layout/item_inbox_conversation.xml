<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/circuit_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:padding="14dp">

        <TextView
            android:id="@+id/conversationName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/conversationTime"
            android:textColor="@color/circuit_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/conversationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:textColor="@color/circuit_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/conversationPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/conversationName"
            android:layout_marginTop="5dp"
            android:layout_toStartOf="@id/conversationUnreadCount"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/circuit_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/conversationUnreadCount"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/conversationTime"
            android:layout_marginTop="8dp"
            android:background="@drawable/circle_bg"
            android:gravity="center"
            android:textColor="@color/circuit_black"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>
