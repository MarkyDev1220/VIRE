<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    card_view:cardCornerRadius="14dp"
    card_view:cardElevation="6dp"
    android:foreground="?android:attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Rank Number -->
        <TextView
            android:id="@+id/tvRankNumber"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="1"
            android:textStyle="bold"
            android:textSize="18sp"
            android:background="@drawable/rank_circle_bg"
            android:textColor="@android:color/white" />

        <!-- Avatar -->
        <ImageView
            android:id="@+id/imgPlayerAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_toEndOf="@id/tvRankNumber"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_profile_placeholder"
            android:background="@drawable/avatar_circle_bg"
            android:scaleType="centerCrop" />

        <!-- Username -->
        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgPlayerAvatar"
            android:layout_marginStart="12dp"
            android:text="PlayerName"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <!-- Game Name -->
        <TextView
            android:id="@+id/tvGameName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvUsername"
            android:layout_alignStart="@id/tvUsername"
            android:text="Game: BSS"
            android:textSize="14sp"
            android:textColor="#757575" />

        <!-- Points -->
        <TextView
            android:id="@+id/tvPoints"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="1520 pts"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#3F51B5" />

        <!-- Wins-Losses-Ties -->
        <TextView
            android:id="@+id/tvWLT"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/tvPoints"
            android:layout_marginTop="4dp"
            android:text="W: 10 | L: 5 | T: 2"
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="end" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>

