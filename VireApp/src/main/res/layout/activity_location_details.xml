<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".LocationDetailsActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Header Image -->
        <ImageView
            android:id="@+id/detailsImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_placeholder"
            android:contentDescription="Store Image" />

        <!-- Store Name -->
        <TextView
            android:id="@+id/detailsName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsImage"
            android:layout_marginTop="12dp"
            android:text="Store Name"
            android:textColor="#212121"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Type & Claim Badges -->
        <LinearLayout
            android:id="@+id/detailsBadgesRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsName"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detailsTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_background"
                android:backgroundTint="#E3F2FD"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Local Game Store"
                android:textColor="#1565C0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailsClaimedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#E8F5E9"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="✓ Claimed &amp; Verified"
                android:textColor="#2E7D32"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Rating -->
        <TextView
            android:id="@+id/detailsRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsBadgesRow"
            android:layout_marginTop="6dp"
            android:text="★ 5.0 (0 reviews)"
            android:textColor="#F57F17"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Address & Contact Info -->
        <TextView
            android:id="@+id/detailsAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsRating"
            android:layout_marginTop="8dp"
            android:text="📍 123 Gaming Street, City, State"
            android:textColor="#424242"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/detailsPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsAddress"
            android:layout_marginTop="4dp"
            android:text="📞 (512) 555-0199"
            android:textColor="#424242"
            android:textSize="14sp" />

        <!-- Action buttons row (Claim, Website) -->
        <LinearLayout
            android:id="@+id/detailsActionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsPhone"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClaimStore"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Claim Store Page"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnVisitWebsite"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Visit Website"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Supported Games -->
        <TextView
            android:id="@+id/detailsGamesHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsActionsRow"
            android:layout_marginTop="16dp"
            android:text="Supported Games &amp; Events"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailsGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsGamesHeader"
            android:layout_marginTop="4dp"
            android:text="Magic: The Gathering, Pokémon, D&amp;D, Board Games"
            android:textColor="#616161"
            android:textSize="14sp" />

        <!-- Description -->
        <TextView
            android:id="@+id/detailsDescHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsGames"
            android:layout_marginTop="16dp"
            android:text="About Store"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsDescHeader"
            android:layout_marginTop="4dp"
            android:text="Store description goes here..."
            android:textColor="#616161"
            android:textSize="14sp" />

        <!-- Reviews Section Header -->
        <RelativeLayout
            android:id="@+id/reviewsHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsDescription"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Player Reviews"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnWriteReview"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="+ Write Review"
                android:textColor="#1565C0" />
        </RelativeLayout>

        <!-- Store Reviews List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerStoreReviews"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/reviewsHeaderRow"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <!-- Hamburger Menu Button -->
        <ImageButton
            android:id="@+id/hamburgerButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_below="@id/recyclerStoreReviews"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20dp"
            android:background="@drawable/circle_bg"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu_hamburger"
            app:tint="@android:color/white" />

    </RelativeLayout>

</ScrollView>
