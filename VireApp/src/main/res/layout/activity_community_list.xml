<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/community_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/circuit_bg"
    android:fitsSystemWindows="true"
    tools:context=".CommunityListActivity">

    <LinearLayout
        android:id="@+id/communityHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="VIRE / COMMUNITIES"
                android:textColor="@color/circuit_text_muted"
                android:textSize="10sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Find your people"
                android:textColor="@color/circuit_text_primary"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/btnCommunityNotifications"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_bell"
            app:tint="@color/circuit_text_primary" />
        <ImageView
            android:id="@+id/btnCommunityProfile"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/profile_image_bg"
            android:contentDescription="My Profile"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_placeholder" />
    </LinearLayout>

    <EditText
        android:id="@+id/searchCommunities"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/communityHeaderRow"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/search_bar_bg"
        android:hint="Search communities or games"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="@color/circuit_text_primary"
        android:textColorHint="@color/circuit_text_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/rowCommunityFilter"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_below="@id/searchCommunities"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/pill_tab_active"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="All games"
            android:textColor="@color/circuit_lime"
            android:textSize="12sp" />
        <Spinner
            android:id="@+id/spinnerCommunityCategory"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/pill_tab_inactive"
            android:paddingHorizontal="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCommunitySectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/rowCommunityFilter"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="Built around your games"
        android:textColor="@color/circuit_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerCommunities"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/tvCommunitySectionTitle"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="96dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateCommunity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNav"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Create Community"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/circuit_lime"
        app:tint="@color/circuit_black" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />
</RelativeLayout>
