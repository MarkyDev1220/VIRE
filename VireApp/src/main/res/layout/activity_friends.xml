<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/friendsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/circuit_bg"
    android:fitsSystemWindows="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp">

    <!-- Header Row -->
    <RelativeLayout
        android:id="@+id/friendsHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/friendsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Friends"
            android:textColor="@color/circuit_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/addFriendHeaderButton"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:backgroundTint="@color/circuit_lime"
            android:text="+ Add Friend"
            android:textColor="@color/circuit_black"
            android:textSize="12sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Search Bar -->
    <EditText
        android:id="@+id/searchInputFriends"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/friendsHeaderRow"
        android:layout_marginBottom="12dp"
        android:background="@drawable/edit_text_bg"
        android:hint="Search friends"
        android:inputType="text"
        android:textColor="@color/circuit_text_primary"
        android:textColorHint="@color/circuit_text_muted" />

    <!-- Friends List -->
    <ListView
        android:id="@+id/friendsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/requestsHeader"
        android:layout_below="@id/searchInputFriends"
        android:layout_marginBottom="8dp"
        android:divider="@color/circuit_divider"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/emptyFriendsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchInputFriends"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="No friends added yet. Tap 'Find Players' or 'Search' in the menu to connect!"
        android:textColor="@color/circuit_text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Pending Requests Header -->
    <TextView
        android:id="@+id/requestsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/requestsListView"
        android:layout_marginBottom="4dp"
        android:text="Pending Requests"
        android:textColor="@color/circuit_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Pending Requests List -->
    <ListView
        android:id="@+id/requestsListView"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_above="@id/bottomNav"
        android:layout_marginBottom="8dp"
        android:divider="@color/circuit_divider"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/emptyRequestsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/requestsListView"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="No pending friend requests."
        android:textColor="@color/circuit_text_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Bottom Navigation Bar -->
    <include
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
