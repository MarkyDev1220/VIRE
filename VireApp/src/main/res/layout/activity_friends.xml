<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/friendsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Header Text -->
    <TextView
        android:id="@+id/friendsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Friends"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="8dp"/>

    <!-- Search Bar -->
    <EditText
        android:id="@+id/searchInputFriends"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search friends"
        android:textColor="#111111"
        android:textColorHint="#777777"
        android:background="@drawable/edit_text_bg"
        android:layout_below="@id/friendsHeader"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <!-- Friends List -->
    <ListView
        android:id="@+id/friendsListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/searchInputFriends"
        android:layout_above="@id/requestsHeader"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/emptyFriendsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/searchInputFriends"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:text="No friends added yet. Tap 'Find Players' or 'Search' in the menu to connect!"
        android:textColor="#666666"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Pending Requests Header -->
    <TextView
        android:id="@+id/requestsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pending Requests"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_above="@id/requestsListView"
        android:layout_marginBottom="4dp"/>

    <!-- Pending Requests List -->
    <ListView
        android:id="@+id/requestsListView"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="80dp"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"/>

    <TextView
        android:id="@+id/emptyRequestsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/requestsListView"
        android:layout_marginTop="16dp"
        android:text="No pending friend requests."
        android:textColor="#777777"
        android:textSize="14sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Hamburger menu fixed bottom-right -->
    <ImageButton
        android:id="@+id/hamburgerButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:background="@drawable/circle_bg"
        android:src="@drawable/ic_menu_hamburger"
        android:contentDescription="Menu"
        android:tint="@android:color/white" />

</RelativeLayout>
