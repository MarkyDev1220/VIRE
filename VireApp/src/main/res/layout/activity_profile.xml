<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/circuit_bg"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/scrollViewRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:fillViewport="true"
        android:background="@color/circuit_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/profileScreenHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="VIRE / THE PEOPLE BEHIND THE DECKS"
                        android:textColor="@color/circuit_text_muted"
                        android:textSize="10sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Player profile"
                        android:textColor="@color/circuit_text_primary"
                        android:textSize="25sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ImageButton
                    android:id="@+id/btnProfileSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Settings"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/circuit_text_primary" />
            </LinearLayout>

            <!-- Cover Photo Area -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="96dp">

                <ImageView
                    android:id="@+id/coverPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/default_cover"
                    android:background="@color/circuit_card"
                    android:contentDescription="Cover Photo" />

                <ImageButton
                    android:id="@+id/changeCoverButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:src="@drawable/ic_camera"
                    android:background="@drawable/circle_bg"
                    app:tint="@color/circuit_black"
                    android:contentDescription="Change Cover" />
            </FrameLayout>

            <!-- Profile Image Area -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="-42dp">

                <ImageView
                    android:id="@+id/profileImage"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/profile_image_bg"
                    android:padding="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile_placeholder"
                    android:contentDescription="Profile Image" />

                <ImageButton
                    android:id="@+id/changeProfilePicButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_camera"
                    android:background="@drawable/circle_bg"
                    app:tint="@color/circuit_black"
                    android:contentDescription="Change Profile Pic" />
            </FrameLayout>

            <!-- Header Info: Full Name, Username, Edit Pen Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/editPenButton">

                    <TextView
                        android:id="@+id/profileFullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Name:"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@color/circuit_text_primary" />

                    <TextView
                        android:id="@+id/profileUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username:"
                        android:textSize="15sp"
                        android:textColor="@color/circuit_text_secondary"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/editPenButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_pen"
                    android:background="@drawable/circle_bg"
                    app:tint="@color/circuit_black"
                    android:contentDescription="Edit Profile" />
            </RelativeLayout>

            <TextView
                android:id="@+id/profileEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Email:"
                android:textSize="15sp"
                android:textColor="@color/circuit_text_muted"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/profileGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gender: Not set"
                android:textSize="16sp"
                android:textColor="@color/circuit_text_primary"
                android:layout_marginTop="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/circuit_divider"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/profileAboutMe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About Me:"
                android:textSize="16sp"
                android:textColor="@color/circuit_text_primary"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/profileGamerBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gamer Bio:"
                android:textSize="16sp"
                android:textColor="@color/circuit_text_secondary"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/circuit_divider"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/profileGames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Games:"
                android:textSize="16sp"
                android:textColor="@color/circuit_text_primary"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/profileGenres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Favorite Genres:"
                android:textSize="16sp"
                android:textColor="@color/circuit_text_secondary"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/profileSkillLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skill Level:"
                android:textSize="16sp"
                android:textColor="@color/circuit_text_secondary"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/profileLocalArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Local Gaming Area:"
                android:textSize="16sp"
                android:textColor="@color/circuit_text_secondary"
                android:layout_marginTop="8dp" />

            <!-- Social Links Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/socialDiscord"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_discord"
                        android:background="@null"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Discord" />

                    <ImageButton
                        android:id="@+id/socialInstagram"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_instagram"
                        android:background="@null"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Instagram" />

                    <ImageButton
                        android:id="@+id/socialTiktok"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_tiktok"
                        android:background="@null"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Tiktok" />

                    <ImageButton
                        android:id="@+id/socialFacebook"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_facebook"
                        android:background="@null"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Facebook" />

                    <ImageButton
                        android:id="@+id/socialtwitch"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_twitch"
                        android:background="@null"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="Twitch" />

                    <ImageButton
                        android:id="@+id/socialkick"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_kick"
                        android:background="@null"
                        android:contentDescription="Kick" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Profile actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/addFriendButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add Friend"
                    android:backgroundTint="@color/circuit_lime"
                    android:textColor="@color/circuit_black"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnProfileMessage"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Message"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/circuit_surface"
                    android:textColor="@color/circuit_text_primary"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/viewCollectionButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Collection"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/circuit_surface"
                    android:textColor="@color/circuit_text_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profileTabs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/pill_tab_inactive"
                android:orientation="horizontal"
                android:padding="4dp">
                <TextView
                    android:id="@+id/profileTabActivity"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/pill_tab_active"
                    android:gravity="center"
                    android:text="Activity"
                    android:textColor="@color/circuit_lime"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/profileTabAbout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="About"
                    android:textColor="@color/circuit_text_secondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/profileTabDecks"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Decks"
                    android:textColor="@color/circuit_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hosted Game Nights"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/circuit_text_primary"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

            <ListView
                android:id="@+id/hostedGameNightsListView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:divider="@color/circuit_divider"
                android:dividerHeight="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profile Feed"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/circuit_text_primary"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"/>

            <ListView
                android:id="@+id/profileFeedListView"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:divider="@color/circuit_divider"
                android:dividerHeight="1dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <include
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
