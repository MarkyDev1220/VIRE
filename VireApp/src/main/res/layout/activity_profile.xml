<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollViewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/profile_bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/coverPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/default_cover"
                android:background="#333"
                android:contentDescription="Cover Photo" />

            <ImageButton
                android:id="@+id/changeCoverButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:src="@drawable/ic_camera"
                android:background="@drawable/circle_bg"
                app:tint="@android:color/white"
                android:contentDescription="Change Cover" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-60dp">

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/profile_image_bg"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_placeholder"
                android:contentDescription="Profile Image" />

            <ImageButton
                android:id="@+id/changeProfilePicButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_camera"
                android:background="@drawable/circle_bg"
                app:tint="@android:color/white"
                android:contentDescription="Change Profile Pic" />
        </FrameLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/profileUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username:"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/editPenButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_pen"
                android:background="@drawable/circle_bg"
                app:tint="@android:color/white"
                android:contentDescription="Edit Profile" />
        </RelativeLayout>

        <TextView
            android:id="@+id/profileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email:"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/profileGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gender: Not set"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/profileAboutMe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About Me:"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/profileGamerBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gamer Bio:"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/profileGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Games:"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/profileGenres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Favorite Genres:"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/profileSkillLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skill Level:"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/profileLocalArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Local Gaming Area:"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="8dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/socialDiscord"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_discord"
                    android:background="@null"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Discord" />

                <ImageButton
                    android:id="@+id/socialInstagram"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_instagram"
                    android:background="@null"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Instagram" />

                <ImageButton
                    android:id="@+id/socialTiktok"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_tiktok"
                    android:background="@null"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Tiktok" />

                <ImageButton
                    android:id="@+id/socialFacebook"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_facebook"
                    android:background="@null"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Facebook" />

                <ImageButton
                    android:id="@+id/socialtwitch"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_twitch"
                    android:background="@null"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Twitch" />

                <ImageButton
                    android:id="@+id/socialkick"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_kick"
                    android:background="@null"
                    android:contentDescription="Kick" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/addFriendButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Add Friend" />

            <Button
                android:id="@+id/viewCollectionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="My Collection" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hosted Game Nights"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <ListView
            android:id="@+id/hostedGameNightsListView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:divider="#EEEEEE"
            android:dividerHeight="1dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile Feed"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <ListView
            android:id="@+id/profileFeedListView"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:divider="#EEEEEE"
            android:dividerHeight="1dp" />

        <ImageButton
            android:id="@+id/hamburgerButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:background="@drawable/circle_bg"
            android:src="@drawable/ic_menu_hamburger"
            app:tint="@android:color/white"
            android:contentDescription="Menu" />

    </LinearLayout>
</ScrollView>
