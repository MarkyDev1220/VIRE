<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollViewRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:paddingBottom="24dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="0dp">

        <!-- Cover Photo -->
        <ImageView
            android:id="@+id/coverPhoto"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            android:src="@drawable/default_cover"
            android:elevation="6dp"
            android:contentDescription="Cover Photo" />

        <!-- Change Cover Photo Button -->
        <ImageButton
            android:id="@+id/changeCoverButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignBottom="@id/coverPhoto"
            android:layout_alignEnd="@id/coverPhoto"
            android:layout_margin="12dp"
            android:background="@drawable/circle_bg"
            android:src="@drawable/ic_camera"
            android:tint="@android:color/white"
            android:contentDescription="Change Cover Photo" />

        <!-- Profile Image -->
        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_below="@id/coverPhoto"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="-60dp"
            android:background="@drawable/profile_image_bg"
            android:padding="4dp"
            android:elevation="6dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:clipToOutline="true"
            android:src="@drawable/ic_profile_placeholder"
            android:contentDescription="Profile Picture" />

        <!-- Change Profile Pic Button -->
        <ImageButton
            android:id="@+id/changeProfilePicButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignEnd="@id/profileImage"
            android:layout_alignBottom="@id/profileImage"
            android:background="@drawable/circle_bg"
            android:src="@drawable/ic_camera"
            android:tint="@android:color/white"
            android:contentDescription="Change Profile Picture" />

        <!-- Edit Pen Button -->
        <ImageButton
            android:id="@+id/editPenButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_below="@id/coverPhoto"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/circle_bg"
            android:src="@drawable/ic_pen"
            android:tint="@android:color/white"
            android:contentDescription="Edit Profile" />

        <!-- Profile Info Layout -->
        <LinearLayout
            android:id="@+id/profileInfoLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/profileImage"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <TextView
                android:id="@+id/profileTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Profile"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/profileUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username: "
                android:textSize="18sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/profileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email: "
                android:textSize="18sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/profileGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gender: Not set"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/profileAboutMe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="About Me: "
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/profileGames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Games: "
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp" />

            <!-- Add Friend Button -->
            <Button
                android:id="@+id/addFriendButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Friend"
                android:layout_marginTop="12dp" />

            <!-- Social Icons -->
            <LinearLayout
                android:id="@+id/socialLinksLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/socialkick"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_kick"
                    android:background="@null"
                    android:contentDescription="Kick" />

                <ImageButton
                    android:id="@+id/socialtwitch"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_twitch"
                    android:background="@null"
                    android:contentDescription="Twitch" />

                <ImageButton
                    android:id="@+id/socialFacebook"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_facebook"
                    android:background="@null"
                    android:contentDescription="Facebook" />

                <ImageButton
                    android:id="@+id/socialDiscord"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_discord"
                    android:background="@null"
                    android:contentDescription="Discord" />

                <ImageButton
                    android:id="@+id/socialTiktok"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_tiktok"
                    android:background="@null"
                    android:contentDescription="Tiktok" />

                <ImageButton
                    android:id="@+id/socialInstagram"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="4dp"
                    android:src="@drawable/ic_instagram"
                    android:background="@null"
                    android:contentDescription="Instagram" />

            </LinearLayout>

        </LinearLayout>

        <!-- Profile Feed ListView -->
        <ListView
            android:id="@+id/profileFeedListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/profileInfoLayout"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="1dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />

        <!-- Floating Hamburger Menu Button -->
        <ImageButton
            android:id="@+id/hamburgerButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="16dp"
            android:background="@drawable/circle_bg"
            android:src="@drawable/ic_menu_hamburger"
            android:tint="@android:color/white"
            android:contentDescription="Menu" />

    </RelativeLayout>

</ScrollView>
