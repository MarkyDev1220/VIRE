<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".TournamentDetailsActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Title -->
        <TextView
            android:id="@+id/detailsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tournament Title"
            android:textColor="#212121"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Badges Row -->
        <LinearLayout
            android:id="@+id/detailsBadgesRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsTitle"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detailsGameBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_background"
                android:backgroundTint="#E3F2FD"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Magic: The Gathering"
                android:textColor="#1565C0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailsFormatBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#FFF3E0"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Swiss"
                android:textColor="#E65100"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailsStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#E8F5E9"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Upcoming"
                android:textColor="#2E7D32"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Date, Time, Location -->
        <TextView
            android:id="@+id/detailsDateTimeLoc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsBadgesRow"
            android:layout_marginTop="10dp"
            android:text="📅 Date • Time\n📍 Location"
            android:textColor="#424242"
            android:textSize="14sp" />

        <!-- Fee & Prizes -->
        <TextView
            android:id="@+id/detailsFeePrizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsDateTimeLoc"
            android:layout_marginTop="6dp"
            android:text="💵 Entry Fee: Free • Organizer: Admin"
            android:textColor="#2E7D32"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Rules & Prizes Box -->
        <TextView
            android:id="@+id/detailsRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsFeePrizes"
            android:layout_marginTop="10dp"
            android:background="#F5F5F5"
            android:padding="10dp"
            android:text="Rules &amp; Prizes..."
            android:textColor="#616161"
            android:textSize="13sp" />

        <!-- Action Buttons (Register, Generate Brackets) -->
        <LinearLayout
            android:id="@+id/detailsActionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsRules"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRegisterTournament"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Register for Event"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnGenerateBrackets"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Generate Brackets"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- External Link Buttons (Discord & External Bracket) -->
        <LinearLayout
            android:id="@+id/externalLinksRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/detailsActionsRow"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOpenDiscord"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💬 Open Discord"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnOpenExternalBracket"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="🌐 External Bracket"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Bracket Matches Section -->
        <TextView
            android:id="@+id/matchesHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/externalLinksRow"
            android:layout_marginTop="20dp"
            android:text="Tournament Brackets &amp; Pairings"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/emptyMatchesText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/matchesHeader"
            android:layout_marginTop="4dp"
            android:text="Brackets have not been generated yet. The organizer will pair Round 1 when registration closes!"
            android:textColor="#757575"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/emptyMatchesText"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <!-- Hamburger Menu Button -->
        <ImageButton
            android:id="@+id/hamburgerButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_below="@id/recyclerMatches"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="20dp"
            android:background="@drawable/circle_bg"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu_hamburger"
            app:tint="@android:color/white" />

    </RelativeLayout>

</ScrollView>
