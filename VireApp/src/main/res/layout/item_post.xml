<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/circuit_card_bg"
    android:layout_marginBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/usernameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/circuit_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnPostActions"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Report post or block player"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <ImageView
        android:id="@+id/postImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/contentText"
        android:textSize="15sp"
        android:textColor="@color/circuit_text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/likeButton"
            android:text="Like"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:textSize="12sp"
            android:backgroundTint="@color/circuit_lime"
            android:textColor="@color/circuit_black"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/commentButton"
            android:text="Comment"
            android:layout_marginStart="10dp"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:textSize="12sp"
            android:backgroundTint="@color/circuit_surface"
            android:textColor="@color/circuit_text_primary"
            android:textStyle="bold"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/commentsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

</LinearLayout>
