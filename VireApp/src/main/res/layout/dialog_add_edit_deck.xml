<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deck Name *"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDeckName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Atraxa Superfriends, Blue-Eyes White"
            android:inputType="textCapWords" />

        <!-- Game System -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="TCG / Card Game System *"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerDeckGame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <!-- Format -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Format"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDeckFormat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. Commander, Standard, Advanced, Modern"
            android:inputType="textCapWords" />

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Deck Strategy &amp; Description"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDeckDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Win cons, key combos, mulligan tips..."
            android:inputType="textMultiLine"
            android:lines="3" />

        <!-- Discord Match Room Link -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Discord / Video Match Room Link (Optional)"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editDeckDiscordUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://discord.gg/yourroom"
            android:inputType="textUri" />

        <!-- Public Checkbox -->
        <CheckBox
            android:id="@+id/checkDeckPublic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="Make Deck Public for Community Sharing" />

        <!-- Photo Cover -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Deck Cover Image"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/deckImagePreview"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_placeholder"
                android:contentDescription="Cover Preview" />

            <Button
                android:id="@+id/btnPickDeckPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Choose Photo" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
