<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp"
    android:foreground="?android:attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/locationImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_placeholder"
            android:contentDescription="Store Image" />

        <TextView
            android:id="@+id/locationName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/locationImage"
            android:layout_marginStart="10dp"
            android:text="Store Name"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/locationBadges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/locationName"
            android:layout_toEndOf="@id/locationImage"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/locationTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_background"
                android:backgroundTint="#E3F2FD"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Local Game Store"
                android:textColor="#1565C0"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/locationClaimedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#E8F5E9"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="✓ Verified"
                android:textColor="#2E7D32"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/locationRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/locationBadges"
            android:layout_toEndOf="@id/locationImage"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:text="★ 5.0 (0 reviews)"
            android:textColor="#F57F17"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/locationAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/locationRating"
            android:layout_toEndOf="@id/locationImage"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:text="Address, City, State"
            android:textColor="#666666"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/locationGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/locationImage"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Games: MTG, Pokémon, D&amp;D"
            android:textColor="#757575"
            android:textSize="12sp" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
