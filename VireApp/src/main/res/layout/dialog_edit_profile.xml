<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Profile"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginBottom="16dp"/>

        <!-- Username -->
        <EditText
            android:id="@+id/editUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username"
            android:textColor="#111111"
            android:textColorHint="#777777"
            android:background="@drawable/edit_text_bg"/>

        <!-- Email -->
        <EditText
            android:id="@+id/editEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:textColor="#111111"
            android:textColorHint="#777777"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="10dp"/>

        <!-- About Me -->
        <EditText
            android:id="@+id/editAboutMe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="About Me"
            android:inputType="textMultiLine"
            android:textColor="#111111"
            android:textColorHint="#777777"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="10dp"/>

        <!-- Favorite Games -->
        <EditText
            android:id="@+id/editGames"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Favorite Games (comma separated)"
            android:textColor="#111111"
            android:textColorHint="#777777"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="10dp"/>

        <!-- Favorite Genres -->
        <EditText
            android:id="@+id/editGenres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Favorite Genres (comma separated)"
            android:textColor="#111111"
            android:textColorHint="#777777"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="10dp"/>

        <!-- Skill Level -->
        <EditText
            android:id="@+id/editSkillLevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Skill Level (Beginner / Intermediate / Advanced)"
            android:textColor="#111111"
            android:textColorHint="#777777"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="10dp"/>

        <!-- Local Gaming Area -->
        <EditText
            android:id="@+id/editLocalArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Local Gaming Area (City / Store)"
            android:textColor="#111111"
            android:textColorHint="#777777"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="10dp"/>

        <!-- Gamer Bio -->
        <EditText
            android:id="@+id/editGamerBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gamer Bio"
            android:inputType="textMultiLine"
            android:textColor="#111111"
            android:textColorHint="#777777"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="10dp"/>

        <!-- Date of Birth -->
        <EditText
            android:id="@+id/editDOB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date of Birth"
            android:focusable="false"
            android:textColor="#111111"
            android:textColorHint="#777777"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="10dp"/>

        <!-- Gender -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gender"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="14dp"/>

        <Spinner
            android:id="@+id/editGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="4dp"
            android:entries="@array/gender_options"/>

        <!-- Social Links -->
        <EditText
            android:id="@+id/editSocials"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Socials (paste profile links)"
            android:inputType="textUri"
            android:textColor="#111111"
            android:textColorHint="#777777"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="10dp"/>

        <!-- Theme Button -->
        <Button
            android:id="@+id/editThemeButtonDialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Change Theme"
            android:backgroundTint="#3F51B5"
            android:textColor="@android:color/white"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
