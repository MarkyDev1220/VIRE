<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/challenges_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/circuit_bg"
    android:fitsSystemWindows="true"
    android:padding="12dp"
    tools:context=".ChallengesActivity">

    <!-- Header -->
    <TextView
        android:id="@+id/challengesText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="Challenges"
        android:textColor="@color/circuit_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Search + filter -->
    <LinearLayout
        android:id="@+id/filtersRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/challengesText"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SearchView
            android:id="@+id/searchViewChallenges"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:queryHint="Search challenges" />

        <Spinner
            android:id="@+id/spinnerGame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyTextChallenges"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/filtersRow"
        android:layout_centerHorizontal="true"
        android:padding="16dp"
        android:text="No challenges yet."
        android:textColor="@color/circuit_text_muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChallenges"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNav"
        android:layout_below="@id/filtersRow"
        android:layout_marginTop="8dp" />

    <!-- Create challenge FAB (+) moved UP above bottom navigation menu -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateChallenge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomNav"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Create challenge"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/circuit_lime"
        app:tint="@color/circuit_black" />

    <!-- Bottom Navigation Bar -->
    <include
        layout="@layout/layout_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
