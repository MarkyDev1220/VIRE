<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="3dp"
    android:foreground="?android:attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <ImageView
            android:id="@+id/collectionItemImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_placeholder" />

        <TextView
            android:id="@+id/collectionItemTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/collectionItemImage"
            android:layout_toStartOf="@+id/collectionItemMoreButton"
            android:layout_marginStart="10dp"
            android:text="Item Title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/collectionItemMoreButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/collectionItemTitle"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Options"
            android:src="@drawable/ic_more_vert" />

        <LinearLayout
            android:id="@+id/badgesLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/collectionItemTitle"
            android:layout_toEndOf="@id/collectionItemImage"
            android:layout_marginStart="10dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Type Badge (Game, Deck, Expansion) -->
            <TextView
                android:id="@+id/collectionItemTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_background"
                android:backgroundTint="#E0E0E0"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="Game"
                android:textColor="#333333"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Status Badge (OWNED, WANT, TRADING, SELLING) -->
            <TextView
                android:id="@+id/collectionItemStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#4CAF50"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="OWNED"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/collectionItemCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/badgesLayout"
            android:layout_toEndOf="@id/collectionItemImage"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:text="Board Game"
            android:textColor="#666666"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/collectionItemNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/collectionItemImage"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Notes..."
            android:textColor="#777777"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/collectionItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/badgesLayout"
            android:text="$0.00"
            android:textColor="#2E7D32"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
