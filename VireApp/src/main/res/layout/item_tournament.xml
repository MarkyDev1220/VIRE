<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_margin="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tournamentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tournament name"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tournamentGame"
            android:layout_below="@id/tournamentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Game" />

        <TextView
            android:id="@+id/tournamentPlayers"
            android:layout_below="@id/tournamentGame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Min players" />

        <TextView
            android:id="@+id/tournamentOrganizer"
            android:layout_below="@id/tournamentPlayers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Organizer" />

        <ImageButton
            android:id="@+id/tournamentMore"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_more_vert"
            android:contentDescription="Menu" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>