<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/circuit_bg">

    <!-- ======================================================== -->
    <!-- SCREEN 1: MESSAGES INBOX (Matches Figma Design)         -->
    <!-- ======================================================== -->
    <RelativeLayout
        android:id="@+id/inboxContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:id="@+id/inboxHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/inboxEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="VIRE / STAY IN THE LOOP"
                    android:textColor="@color/circuit_text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/inboxTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Messages"
                    android:textColor="@color/circuit_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Actions on right: Notifications Bell & Profile Avatar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnInboxNotifications"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Notifications"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/circuit_text_primary" />

                <ImageView
                    android:id="@+id/btnInboxProfile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/profile_image_bg"
                    android:contentDescription="My Profile"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile_placeholder" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Search Bar & 'New chat' Button Row -->
        <LinearLayout
            android:id="@+id/searchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/inboxHeader"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <!-- Search Field -->
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/search_bar_bg"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/searchIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Search"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/circuit_text_muted" />

                <EditText
                    android:id="@+id/searchMessagesInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_toStartOf="@+id/btnClearSearch"
                    android:layout_toEndOf="@id/searchIcon"
                    android:background="@null"
                    android:hint="Search messages"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/circuit_text_primary"
                    android:textColorHint="@color/circuit_text_muted"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@null"
                    android:contentDescription="Clear Search"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/circuit_text_muted" />
            </RelativeLayout>

            <!-- 'New chat' Pill Button -->
            <Button
                android:id="@+id/btnNewChat"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/circuit_lime"
                android:paddingHorizontal="14dp"
                android:text="New chat"
                android:textColor="@color/circuit_black"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="22dp" />
        </LinearLayout>

        <!-- Filter Pill Tabs: All | Unread · 2 | Groups -->
        <LinearLayout
            android:id="@+id/tabsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/searchRow"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/pill_tab_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="All"
                android:textColor="@color/circuit_lime"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabUnread"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/pill_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Unread · 2"
                android:textColor="@color/circuit_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabGroups"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/pill_tab_inactive"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Groups"
                android:textColor="@color/circuit_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Friends & Requests Banner Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFriendsRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tabsRow"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/circuit_card"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:id="@+id/friendsBannerIcon"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/circle_background"
                    android:contentDescription="Friends"
                    android:padding="8dp"
                    android:src="@drawable/ic_friends"
                    app:tint="@color/circuit_lime" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toStartOf="@+id/chevronIcon"
                    android:layout_toEndOf="@id/friendsBannerIcon"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Friends &amp; requests"
                        android:textColor="@color/circuit_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFriendsRequestsSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="189 friends · 3 requests waiting"
                        android:textColor="@color/circuit_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/chevronIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Open Friends"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/circuit_text_muted" />
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section Header: CONVERSATIONS | Mark all read -->
        <RelativeLayout
            android:id="@+id/conversationsHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/cardFriendsRequests"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvConversationsSectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:letterSpacing="0.08"
                android:text="CONVERSATIONS"
                android:textColor="@color/circuit_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMarkAllRead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="Mark all read"
                android:textColor="@color/circuit_lime"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- User Search Results Section (Shown when user is actively searching) -->
        <TextView
            android:id="@+id/tvSearchUsersHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/conversationsHeaderRow"
            android:letterSpacing="0.08"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="PEOPLE &amp; USERS TO MESSAGE"
            android:textColor="@color/circuit_lime"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSearchUsers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvSearchUsersHeader"
            android:nestedScrollingEnabled="false"
            android:visibility="gone" />

        <!-- Conversations List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerConversations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/inboxFootnote"
            android:layout_below="@id/recyclerSearchUsers"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- Footnote / Security notice -->
        <TextView
            android:id="@+id/inboxFootnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/bottomNav"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="🔒 Your real encrypted chats with conversations"
            android:textColor="@color/circuit_text_muted"
            android:textSize="11sp" />

        <!-- Bottom Navigation Bar -->
        <include
            layout="@layout/layout_bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_alignParentBottom="true" />

    </RelativeLayout>

    <!-- ======================================================== -->
    <!-- SCREEN 2: 1-ON-1 / GROUP CHAT VIEW                      -->
    <!-- ======================================================== -->
    <RelativeLayout
        android:id="@+id/chatContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/circuit_bg"
        android:visibility="gone">

        <!-- Chat Header Bar -->
        <RelativeLayout
            android:id="@+id/chatTopBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/circuit_bottom_nav"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/btnChatBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/circuit_text_primary" />

            <ImageView
                android:id="@+id/chatUserAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@id/btnChatBack"
                android:background="@drawable/circle_background"
                android:contentDescription="Chat User"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_placeholder" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/chatUserAvatar"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/chatHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat User"
                    android:textColor="@color/circuit_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chatHeaderSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active now"
                    android:textColor="@color/circuit_lime"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnChatOptions"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Options"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/circuit_text_primary" />
        </RelativeLayout>

        <!-- Chat Messages RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerChatMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/chatInputBar"
            android:layout_below="@id/chatTopBar"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp" />

        <!-- Chat Input Bar -->
        <LinearLayout
            android:id="@+id/chatInputBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:background="@color/circuit_bottom_nav"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/message_input_bg"
                android:hint="Type a message..."
                android:inputType="textShortMessage|textCapSentences"
                android:maxLines="4"
                android:paddingHorizontal="16dp"
                android:textColor="@color/circuit_text_primary"
                android:textColorHint="@color/circuit_text_muted"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/sendMessage"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_bg"
                android:contentDescription="Send"
                android:src="@drawable/ic_send"
                app:tint="@color/circuit_black" />
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
