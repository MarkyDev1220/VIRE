<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="@color/purple_500">

        <!-- Add Friend Button -->
        <Button
            android:id="@+id/addFriendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Friend"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_700"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:layout_marginEnd="8dp"/>

        <!-- Plus Button (top right) -->
        <ImageButton
            android:id="@+id/newMessageButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:background="@drawable/circle_bg"
            android:src="@drawable/ic_add"
            android:tint="@android:color/white"
            android:contentDescription="New Message" />
    </LinearLayout>

    <!-- MAIN CONTENT: LEFT + RIGHT PANELS -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- LEFT PANEL -->
        <LinearLayout
            android:id="@+id/leftPanel"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.35"
            android:padding="8dp"
            android:background="@color/light_gray">

            <!-- Search users (hidden until "Search for Users" is tapped) -->
            <EditText
                android:id="@+id/searchUsers"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="Search users"
                android:visibility="gone"
                android:background="@drawable/search_bar_bg"
                android:padding="10dp"
                android:textColor="@android:color/black"
                android:textColorHint="@color/darker_gray"/>

            <!-- List of users -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerUsers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@android:color/darker_gray"
                android:dividerHeight="1dp" />
        </LinearLayout>

        <!-- RIGHT PANEL -->
        <RelativeLayout
            android:id="@+id/rightPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.65"
            android:padding="8dp"
            android:background="@color/white"
            android:visibility="visible">

            <!-- Chat header -->
            <TextView
                android:id="@+id/chatHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chat"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@android:color/black"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:padding="4dp"
                android:visibility="visible" />

            <!-- Chat messages -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerChatMessages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/chatHeader"
                android:layout_above="@id/chatInputBar"
                android:paddingBottom="8dp"
                android:visibility="visible" />

            <!-- Input bar -->
            <LinearLayout
                android:id="@+id/chatInputBar"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_above="@id/hamburgerButton"
                android:padding="8dp"
                android:background="@color/light_gray"
                android:visibility="visible">

                <EditText
                    android:id="@+id/messageInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Type a message"
                    android:background="@drawable/message_input_bg"
                    android:textColor="@android:color/black"
                    android:textColorHint="@color/darker_gray"/>

                <ImageButton
                    android:id="@+id/sendMessage"
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_send"
                    android:tint="@android:color/holo_purple"
                    android:contentDescription="Send" />
            </LinearLayout>

            <!-- Hamburger Button -->
            <ImageButton
                android:id="@+id/hamburgerButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_alignParentBottom="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="16dp"
                android:background="@drawable/circle_bg"
                android:src="@drawable/ic_menu_hamburger"
                android:contentDescription="Menu"
                android:tint="@android:color/white" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
