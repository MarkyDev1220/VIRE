<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Incoming message bubble: dark slate surface with subtle border -->
    <solid android:color="@color/circuit_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/circuit_surface_border" />

    <corners
        android:topLeftRadius="18dp"
        android:topRightRadius="18dp"
        android:bottomRightRadius="18dp"
        android:bottomLeftRadius="4dp" />

    <padding
        android:left="14dp"
        android:top="10dp"
        android:right="14dp"
        android:bottom="10dp" />

</shape>
