// ===============================================================
// Firestore Security Rules for VIRE (vire-7b583)
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStringList(values) {
      return values is list &&
        values.size() <= 20 &&
        (values.size() < 1 || values[0] is string) &&
        (values.size() < 2 || values[1] is string) &&
        (values.size() < 3 || values[2] is string) &&
        (values.size() < 4 || values[3] is string) &&
        (values.size() < 5 || values[4] is string) &&
        (values.size() < 6 || values[5] is string) &&
        (values.size() < 7 || values[6] is string) &&
        (values.size() < 8 || values[7] is string) &&
        (values.size() < 9 || values[8] is string) &&
        (values.size() < 10 || values[9] is string) &&
        (values.size() < 11 || values[10] is string) &&
        (values.size() < 12 || values[11] is string) &&
        (values.size() < 13 || values[12] is string) &&
        (values.size() < 14 || values[13] is string) &&
        (values.size() < 15 || values[14] is string) &&
        (values.size() < 16 || values[15] is string) &&
        (values.size() < 17 || values[16] is string) &&
        (values.size() < 18 || values[17] is string) &&
        (values.size() < 19 || values[18] is string) &&
        (values.size() < 20 || values[19] is string);
    }

    function isOptionalImageUrl(data, field) {
      return !(field in data) ||
        (data[field] is string &&
          data[field].size() <= 2048 &&
          (data[field] == '' || data[field].matches('^https://.*')));
    }

    function isValidPublicProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'username', 'usernameLowercase', 'favoriteGames',
          'favoriteGenres', 'skillLevel', 'localArea', 'gamerBio', 'aboutMe'
        ]) &&
        data.keys().hasOnly([
          'uid', 'username', 'usernameLowercase', 'favoriteGames',
          'favoriteGenres', 'skillLevel', 'localArea', 'gamerBio', 'aboutMe',
          'profileImageUrl', 'coverImageUrl'
        ]) &&
        data.uid is string &&
        data.uid == userId &&
        data.username is string &&
        data.username.size() >= 3 &&
        data.username.size() <= 64 &&
        data.usernameLowercase is string &&
        data.usernameLowercase.size() >= 3 &&
        data.usernameLowercase.size() <= 64 &&
        isStringList(data.favoriteGames) &&
        isStringList(data.favoriteGenres) &&
        data.skillLevel is string &&
        data.skillLevel.size() <= 100 &&
        data.localArea is string &&
        data.localArea.size() <= 200 &&
        data.gamerBio is string &&
        data.gamerBio.size() <= 4000 &&
        data.aboutMe is string &&
        data.aboutMe.size() <= 4000 &&
        isOptionalImageUrl(data, 'profileImageUrl') &&
        isOptionalImageUrl(data, 'coverImageUrl');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User profile documents
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isOwner(userId);

      match /blockedUsers/{blockedId} {
        allow read, write: if isOwner(userId);
      }

      match /messageSettings/{threadId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Searchable profile fields only; this document must never contain account PII.
    match /publicProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) &&
        isValidPublicProfile(request.resource.data, userId);
      allow update: if isOwner(userId) &&
        isValidPublicProfile(request.resource.data, userId) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);
    }

    // Private one-to-one conversations and their messages.
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantUids;
      allow create: if isAuthenticated() &&
        request.resource.data.participantUids is list &&
        request.resource.data.participantUids.size() == 2 &&
        request.auth.uid in request.resource.data.participantUids;
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.participantUids &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participantUids', 'participantNames', 'lastMessage', 'lastSenderUid', 'updatedAt'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        function participantInConversation() {
          return request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantUids;
        }
        function participantAfterConversationWrite() {
          return request.auth.uid in getAfter(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantUids;
        }

        allow read: if isAuthenticated() && participantInConversation();
        allow create: if isAuthenticated() && participantAfterConversationWrite() &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 4000 &&
          request.resource.data.senderName is string;
        allow delete: if isAuthenticated() && participantInConversation() &&
          resource.data.senderUid == request.auth.uid;
        allow update: if false;
      }
    }

    // Friend Requests
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // Friends
    match /friends/{friendshipId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() &&
        (resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid ||
         request.auth.uid in resource.data.users);
    }

    // Communities and Community Posts
    match /communities/{communityId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /communityPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    // Global Feed & Comments
    match /globalPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    match /postComments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorUid == request.auth.uid;
    }

    // User Decks & Comments
    match /userDecks/{deckId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /deckComments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Card Collections
    match /collections/{collectionId} {
      allow read, write: if isAuthenticated();
    }

    // Game Nights, Gaming Locations, Store Reviews, Tournaments
    match /gameNights/{id} {
      allow read, write: if isAuthenticated();
    }

    match /gamingLocations/{id} {
      allow read, write: if isAuthenticated();
    }

    match /storeReviews/{id} {
      allow read, write: if isAuthenticated();
    }

    match /tournaments/{id} {
      allow read, write: if isAuthenticated();
    }

    match /tournamentMatches/{id} {
      allow read, write: if isAuthenticated();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.toUid == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false; // Admin view only
    }
  }
}
